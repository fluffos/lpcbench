#include <tests.h>
inherit __DIR__ "subject";

int pending() {
    return sizeof(filter(call_out_info(), (: $1[0] == this_object() :)));
}

void do_tests() {
    int n;
    ASSERT_EQ(0, active);
    apply_buff(100);
    ASSERT_EQ(1, active);
    ASSERT_EQ(1, pending());
    apply_buff(2);
    ASSERT_EQ(1, active);
    ASSERT_EQ(1, pending());
    n = find_call_out("expire");
    ASSERT(n >= 0 && n <= 2);
    remove_call_out("expire");
    ASSERT_EQ(-1, find_call_out("expire"));
    ASSERT_EQ(0, pending());
    expire();
    ASSERT_EQ(0, active);
}
