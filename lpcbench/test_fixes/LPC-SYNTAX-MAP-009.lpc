#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    mapping m = ([ "zero": 0 ]);
    ASSERT_EQ(1, has_key(m, "zero"));
    ASSERT_EQ(0, has_key(m, "missing"));
    ASSERT_EQ(0, has_key(([ ]), "a"));
    ASSERT_EQ(1, has_key(([ "a": "str", "b": 5 ]), "a"));
    ASSERT_EQ(1, has_key(([ "a": "str", "b": 5 ]), "b"));
    ASSERT_EQ(0, has_key(([ "a": "str", "b": 5 ]), "c"));
    ASSERT_EQ(1, has_key(([ "e": "" ]), "e"));
    ASSERT_EQ(1, has_key(([ "e": ({ }) ]), "e"));
    ASSERT_EQ(0, has_key(([ "e": 1 ]), "E"));
}
