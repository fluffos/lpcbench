#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    handle_page_key("q");
    ASSERT_EQ(1, quit_requested);
    handle_page_key(" ");
    ASSERT_EQ(0, quit_requested);
    handle_page_key("Q");
    ASSERT_EQ(1, quit_requested);
    handle_page_key("x");
    ASSERT_EQ(0, quit_requested);
    handle_page_key("Q");
    handle_page_key("");
    ASSERT_EQ(0, quit_requested);
    handle_page_key("q");
    handle_page_key("Qq");
    ASSERT_EQ(0, quit_requested);
    handle_page_key("q");
    handle_page_key("XQ");
    ASSERT_EQ(0, quit_requested);
    handle_page_key("Q");
    handle_page_key("qq");
    ASSERT_EQ(0, quit_requested);
}
