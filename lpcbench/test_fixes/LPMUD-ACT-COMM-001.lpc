#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    add_action("dummy_action", "meditate");
    ASSERT_EQ(1, has_action_verb("meditate"));
    ASSERT_EQ(0, has_action_verb("nonexistent"));
    RESTORETP;
    ASSERT_EQ(1, dummy_action("x"));
    ASSERT_EQ(1, dummy_action(""));
}
