#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    // registered with add_action: two actions on "cast", and nothing runs until the command
    ASSERT_EQ(2, sizeof(filter(commands(), (: $1[0] == "cast" :))));
    ASSERT_EQ(0, first_ran);
    ASSERT_EQ(0, second_ran);
    ASSERT(command("cast fireball"));
    ASSERT_EQ(1, first_ran);
    ASSERT_EQ(1, second_ran);
    first_ran = 0;
    second_ran = 0;
    ASSERT_EQ(0, reject_spell("x"));
    ASSERT_EQ(1, first_ran);
    ASSERT_EQ(0, second_ran);
    ASSERT_EQ(1, accept_spell("x"));
    ASSERT_EQ(1, second_ran);
}
