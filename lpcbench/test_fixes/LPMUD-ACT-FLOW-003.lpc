#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "search" :))));
    ASSERT(command("search"));
    ASSERT_EQ("bare_verb", search_target);
    ASSERT(command("search desk"));
    ASSERT_EQ("desk", search_target);
    ASSERT(command("search"));
    ASSERT_EQ("bare_verb", search_target);
    search_target = "zzz";
    ASSERT_EQ(1, do_search(0));
    ASSERT_EQ("bare_verb", search_target);
    ASSERT_EQ(1, do_search("chest"));
    ASSERT_EQ("chest", search_target);
}
