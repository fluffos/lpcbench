#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    ASSERT_EQ(0, find_living("test_npc"));
    enable_living("test_npc");
    ASSERT(living(this_object()));
    ASSERT_EQ(this_object(), find_living("test_npc"));
    ASSERT_EQ(0, find_living("other_npc"));
    disable_living();
    ASSERT_EQ(0, living(this_object()));
    ASSERT_EQ(0, find_living("test_npc"));
    RESTORETP;
}
