#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    add_action((: do_clap :), "clap");
    RESTORETP;
    ASSERT_EQ(0, ran);
    ASSERT_EQ(0, execute_user_verb("fly"));
    ASSERT_EQ(0, ran);
    ASSERT(execute_user_verb("clap loudly") > 0);
    ASSERT_EQ(1, ran);
    ran = 0;
    ASSERT(execute_user_verb("clap") > 0);
    ASSERT_EQ(1, ran);
    ran = 0;
    ASSERT_EQ(1, do_clap("x"));
    ASSERT_EQ(1, ran);
    ASSERT_EQ(0, execute_user_verb("fly"));
}
