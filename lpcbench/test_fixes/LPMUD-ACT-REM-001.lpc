#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    add_action("action_handler", "pull");
    ASSERT_EQ(0, ran);
    ASSERT(command("pull"));
    ASSERT_EQ(1, ran);
    ran = 0;
    ASSERT_EQ(1, remove_action("action_handler", "pull"));
    RESTORETP;
    ASSERT_EQ(0, command("pull"));
    ASSERT_EQ(0, ran);
    ASSERT_EQ(1, action_handler("x"));
    ASSERT_EQ(1, ran);
}
