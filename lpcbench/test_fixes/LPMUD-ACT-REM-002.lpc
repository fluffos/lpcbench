#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    function fp = (: handle_fp :);
    SAVETP;
    enable_commands();
    add_action(fp, "ring");
    ASSERT_EQ(0, ran);
    ASSERT(command("ring"));
    ASSERT_EQ(1, ran);
    ran = 0;
    ASSERT_EQ(1, remove_action(fp, "ring"));
    RESTORETP;
    ASSERT_EQ(0, command("ring"));
    ASSERT_EQ(0, ran);
    ASSERT_EQ(1, handle_fp("x"));
    ASSERT_EQ(1, ran);
}
