#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "get" :))));
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "take" :))));
    ASSERT(command("get sword"));
    ASSERT_EQ("get", used_verb);
    ASSERT(command("take shield"));
    ASSERT_EQ("take", used_verb);
    ASSERT_EQ(1, do_take("x"));
}
