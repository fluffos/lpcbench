#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "'" :))));
    ASSERT_EQ(1, filter(commands(), (: $1[0] == "'" :))[0][1] & 3);
    ASSERT(command("'hello world"));
    ASSERT_EQ("'hello", last_v);
    ASSERT_EQ("world", last_a);
    ASSERT_EQ(1, do_say("x"));
}
