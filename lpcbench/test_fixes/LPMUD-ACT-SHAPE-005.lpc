#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "" :))));
    ASSERT_EQ(1, filter(commands(), (: $1[0] == "" :))[0][1] & 3);
    ASSERT(command("dance wildly"));
    ASSERT_EQ("dance", intercepted_verb);
    ASSERT_EQ(1, command_monitor("x"));
}
