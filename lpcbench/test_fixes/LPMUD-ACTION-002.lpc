#include <tests.h>
mixed record_notify_fail(mixed msg);
#define notify_fail record_notify_fail
#include "subject.lpc"
#undef notify_fail

mixed *failed = ({ });
mixed record_notify_fail(mixed msg) {
    failed += ({ msg });
    return efun::notify_fail(msg);
}

void do_tests() {
    ASSERT_EQ(0, handle_open_chest("door"));
    ASSERT_EQ(1, sizeof(failed));
    ASSERT_EQ("Open what?\n", failed[0]);
    ASSERT_EQ(1, handle_open_chest("chest"));
    ASSERT_EQ(1, sizeof(failed));
    ASSERT_EQ(0, handle_open_chest(""));
    ASSERT_EQ(2, sizeof(failed));
    ASSERT_EQ("Open what?\n", failed[1]);
    ASSERT_EQ(0, handle_open_chest("Chest"));
    ASSERT_EQ(3, sizeof(failed));
    ASSERT_EQ(1, handle_open_chest("chest"));
    ASSERT_EQ(3, sizeof(failed));
}
