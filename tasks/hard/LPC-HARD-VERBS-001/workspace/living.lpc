// living.lpc: something that can act: players and monsters.
//
// Contract
//  * Everything told to a living is kept and can be read with query_heard().
//  * do_command(str) runs str as this living's command and returns nonzero
//    if a command accepted it.
//  * damage(n, attacker) lowers hp, never below 0. At 0 the living dies: die()
//    runs exactly once however many hits land in the same round.
//  * die() leaves a corpse in the room holding everything the living carried,
//    tells the room "<short> dies.\n", clears every attacker's target if it
//    was this living, then the living leaves the world.
//  * start_combat(target): both sides now fight. heart_beat() runs one round:
//    this living hits its target for query_attack() if it is in the same room.
//    The heart beat stops when no target remains.
#include "defs.h"
inherit __DIR__ "container";

private int hp = 20;
private int max_hp = 20;
private int attack = 3;
private int dead = 0;
private object target;
private string *heard = ({});

void make_living() { enable_commands(); }

void catch_tell(string s) { heard += ({ s }); }
string *query_heard() { return heard; }
void clear_heard() { heard = ({}); }

int do_command(string s) { return command(s); }

void set_hp(int n) { hp = max_hp = n; }
int query_hp() { return hp; }
void heal(int n) { hp += n; }
void set_attack(int n) { attack = n; }
int query_attack() { return attack; }
object query_target() { return target; }
void set_target(object ob) { target = ob; }
int is_dead() { return dead; }

void start_combat(object who) {
    target = who;
    set_heart_beat(1);
    if (who->query_target() != this_object()) {
        who->start_combat(this_object());
    }
}

void stop_combat() {
    target = 0;
    set_heart_beat(0);
}

void die() {
    object corpse, env = environment();

    if (dead)
        return;
    dead = 1;
    corpse = new(__DIR__ "corpse");
    corpse->set_of(this_object()->query_short());
    corpse->move(env);
    foreach (object ob in all_inventory(this_object()))
        ob->move(corpse);
    env->broadcast(this_object()->query_short() + " dies.\n", ({ this_object() }));
    foreach (object ob in all_inventory(env))
        if (ob->query_target() == this_object())
            ob->stop_combat();
    remove();
}

void damage(int n, object from) {
    hp -= n;
    if (hp <= 0) {
        hp = 0;
        die();
    }
}

void heart_beat() {
    if (!target || dead) {
        stop_combat();
        return;
    }
    if (environment(target) != environment())
        return;
    target->damage(this_object()->query_attack(), this_object());
}
