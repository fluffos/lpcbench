// subject.lpc: world factory. Tests and the game driver build everything here.
inherit __DIR__ "room";

object make_room(string desc) {
    object r = new(__DIR__ "room");
    r->set_long(desc);
    return r;
}

object make_living(string name, int hp) {
    object l = new(__DIR__ "living");
    l->set_name(name);
    l->set_short(capitalize(name));
    l->set_hp(hp);
    l->make_living();
    return l;
}

object make_item(string name, int weight) {
    object i = new(__DIR__ "item");
    i->set_name(name);
    i->set_short("a " + name);
    i->set_weight(weight);
    return i;
}

object make_bag(string name, int capacity) {
    object b = new(__DIR__ "container");
    b->set_name(name);
    b->set_short("a " + name);
    b->set_capacity(capacity);
    return b;
}
