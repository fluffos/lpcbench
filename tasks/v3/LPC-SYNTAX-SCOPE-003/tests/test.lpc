#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    ASSERT_EQ(0, called_parent);
    describe_test("testing parent resolution");
    ASSERT_EQ(1, called_parent);
    ASSERT_EQ("testing parent resolution", query_test_info());
    describe_test("second");
    ASSERT_EQ(1, called_parent);
    ASSERT_EQ("second", query_test_info());
}
