#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    mixed *cmds = commands();
    int found = 0;
    foreach (mixed *entry in cmds) {
        if (entry[0] == "poke") {
            ASSERT_EQ("<function>", entry[3]);
            found++;
        }
    }
    ASSERT_EQ(1, found);
    // the bound function returns 1, so the command is handled
    ASSERT(command("poke"));
    ASSERT(command("poke someone"));
}
