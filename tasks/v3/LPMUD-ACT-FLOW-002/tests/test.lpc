#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(2, sizeof(filter(commands(), (: $1[0] == "jump" :))));
    ASSERT_EQ(0, primary_ran);
    ASSERT_EQ(0, secondary_ran);
    ASSERT(command("jump"));
    ASSERT_EQ(1, primary_ran);
    ASSERT_EQ(0, secondary_ran);
    // secondary_jump never runs from the command; it must still do its job when called
    ASSERT_EQ(1, secondary_jump("high"));
    ASSERT_EQ(1, secondary_ran);
    ASSERT_EQ(1, primary_jump("high"));
}
