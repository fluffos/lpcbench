#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(0, pushed);
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "push" :))));
    ASSERT(command("push button"));
    ASSERT_EQ(1, pushed);
    pushed = 0;
    ASSERT_EQ(1, do_push("button"));
    ASSERT_EQ(1, pushed);
}
