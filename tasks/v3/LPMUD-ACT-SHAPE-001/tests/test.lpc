#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "whisper" :))));
    ASSERT(command("whisper secret message"));
    ASSERT_EQ("secret message", last_whisper);
    ASSERT_EQ(1, do_whisper("other words"));
    ASSERT_EQ("other words", last_whisper);
}
