#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object tp;
    SAVETP;
    enable_commands();
    init();
    RESTORETP;
    ASSERT_EQ(1, sizeof(filter(commands(), (: $1[0] == "tele_" :))));
    ASSERT_EQ(2, filter(commands(), (: $1[0] == "tele_" :))[0][1] & 3);
    ASSERT(command("tele_port dalaran"));
    ASSERT_EQ("port", stripped_verb);
    ASSERT_EQ(1, handle_tele("x"));
}
