#include <tests.h>
inherit __DIR__ "subject";

int in_void_or_master(object e) {
    return objectp(e) && (e == master() || base_name(e) == "/single/void");
}

void do_tests() {
    object a = new("/single/void");
    ASSERT_EQ(0, relocated);
    move_or_destruct(a);
    ASSERT_EQ(1, relocated);
    ASSERT_EQ(a, environment(this_object()));
    relocated = 0;
    move_or_destruct(0);
    ASSERT_EQ(1, relocated);
    ASSERT_EQ(1, in_void_or_master(environment(this_object())));
    ASSERT(environment(this_object()) != a);
    relocated = 0;
    move_or_destruct(master());
    ASSERT_EQ(1, relocated);
    ASSERT_EQ(master(), environment(this_object()));
    destruct(a);
}
