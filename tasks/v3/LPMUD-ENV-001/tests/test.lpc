#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object other = new("/single/void");
    move_object(master());
    ASSERT_EQ(1, is_in_environment(this_object(), master()));
    ASSERT_EQ(0, is_in_environment(this_object(), other));
    ASSERT_EQ(0, is_in_environment(this_object(), this_object()));
    ASSERT_EQ(0, is_in_environment(other, master()));
    destruct(other);
}
