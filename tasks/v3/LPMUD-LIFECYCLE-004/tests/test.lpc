#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    ASSERT_EQ(0, count_clones_of_file(__FILE__));
    object c1 = new(__FILE__);
    ASSERT_EQ(1, count_clones_of_file(__FILE__));
    object c2 = new(__FILE__);
    ASSERT_EQ(2, count_clones_of_file(__FILE__));
    destruct(c1);
    ASSERT_EQ(1, count_clones_of_file(__FILE__));
    destruct(c2);
    ASSERT_EQ(0, count_clones_of_file(__FILE__));
}
