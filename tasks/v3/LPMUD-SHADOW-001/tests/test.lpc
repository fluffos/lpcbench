#include <tests.h>
inherit __DIR__ "subject";

void do_tests() {
    object victim = new("/single/void");
    object sh = new(file_name(this_object()));
    ASSERT_EQ(0, get_active_shadow(victim));
    evaluate(bind((: shadow, victim, 1 :), sh));
    ASSERT_EQ(sh, get_active_shadow(victim));
    destruct(sh);
    destruct(victim);
}
